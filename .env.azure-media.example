# =============================================================================
# SIGASJ — Plantilla de Conexión Independiente para Recuperación en Azure SQL
# Copie este archivo a: .env.azure-media
# Complete la contraseña de sigasj_app antes de ejecutar el script.
# NUNCA suba .env.azure-media al repositorio (está protegido en .gitignore).
# =============================================================================

DB_TYPE=mssql
DB_HOST=sigasj-dev.database.windows.net
DB_PORT=1433
DB_DATABASE=sigasj-dev
DB_USERNAME=sigasj_app
DB_PASSWORD=valor_configurado_localmente
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
