# Server Configuration
# Render inyecta PORT automáticamente. Local: 3000.
# Nest escucha en 0.0.0.0 (compatible con Render y con start:dev local).
PORT=3000
NODE_ENV=development

# Database Configuration (TypeORM + driver mssql)
# Producción (Render → Railway): host/port TCP externos reales; usuario de aplicación ≠ sa.
# Local: host/port de su SQL Server de desarrollo.
DB_TYPE=mssql
DB_HOST=localhost
DB_PORT=1434
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=SIGASJ
# Windows Auth / LocalDB (solo desarrollo Windows; no usar en Render)
DB_TRUSTED_CONNECTION=false
# TLS (producción: encrypt implícito true; trustServerCertificate implícito false)
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=false
# CA opcional si Railway/SQL presenta certificado no incluido en el trust store de Node:
# DB_SSL_CA=
# DB_SSL_CA_PATH=
# Nunca use NODE_TLS_REJECT_UNAUTHORIZED=0

# JWT Configuration (producción: secreto fuerte solo en Render; nunca versionar valores reales)
JWT_SECRET=
JWT_EXPIRES_IN=24h

# CORS / Frontend (producción: origen HTTPS autorizado, p. ej. Vercel real — no inventar)
FRONTEND_URL=
# Alternativa / complemento (también usado por correos)
FRONTEND_BASE_URL=http://localhost:5173
# Orígenes adicionales CSV (opcional)
CORS_ALLOWED_ORIGINS=

# Auth local: true fuerza bcrypt también en development
AUTH_REQUIRE_PASSWORD=false

# AcueductosCR Configuration
ACUEDUCTOS_CR_BASE_URL=https://acueductoscr.com
ACUEDUCTOS_CR_PROVINCIA=5
ACUEDUCTOS_CR_ACUEDUCTO=207
ACUEDUCTOS_CR_TIMEOUT=15000
ACUEDUCTOS_CR_RATE_LIMIT_WINDOW_MS=60000
ACUEDUCTOS_CR_RATE_LIMIT_MAX=10

# SMS Infobip (PBI 2.8.2). No pegar secretos reales.
SMS_ENABLED=false
SMS_PROVIDER=
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=
SMS_TEST_MODE=true
SMS_TEST_TO=

# Jotform — solicitudes de ausencia del Fontanero (épica 6.5)
# Formulario público: https://form.jotform.com/262915442146861
# El Frontend solo usa VITE_JOTFORM_FORM_ID; la API key nunca va al bundle.
JOTFORM_FORM_ID=262915442146861
JOTFORM_API_KEY=
JOTFORM_API_BASE_URL=https://api.jotform.com
JOTFORM_WEBHOOK_SECRET=
JOTFORM_VERIFY_SUBMISSION=false
JOTFORM_CORRELACION_TTL_MINUTOS=60
JOTFORM_FIELD_CORRELACION=correlacion
JOTFORM_FIELD_TIPO=tipo
JOTFORM_FIELD_FECHA_INICIO=fechaInicio
JOTFORM_FIELD_FECHA_FIN=fechaFin
JOTFORM_FIELD_MOTIVO=motivo

# Correo al aprobar solicitudes de ausencia.
# Sin SMTP el aviso no llega a Gmail personal (solo logs / Ethereal).
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=SIGASJ ASADA <noreply@asadasanjuan.cr>
